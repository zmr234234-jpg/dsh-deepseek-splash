{
  "name": "dsh-deepseek-splash",
  "version": "1.1.0",
  "description": "DeepSeek 开屏动画：把同一段鲸鱼片头（描边自绘 -> 点灯 -> 填充成形 -> 落款）接到 DSH Desktop 的启动画面，并在桌面更新覆盖启动页后自动装回；同一段动画也可作为可选的全屏客户端浮层。DeepSeek opening animation for DeepSeek Harness: the whale line-draw/fill/wordmark intro rendered as DSH Desktop's launch screen, reinstalled automatically after a desktop update, plus the same animation as an opt-in full-screen client overlay.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/smoke_host.mjs && node tools/smoke_client.mjs",
    "render": "py -3 tools/build_splash.py",
    "install-splash": "py -3 tools/build_splash.py --apply",
    "status": "py -3 tools/build_splash.py --status"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5"
    }
  },
  "files": [
    "lib",
    "dist",
    "assets/whale.svg",
    "assets/preview.html",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-desktop",
    "client-plugin",
    "splash",
    "launch-screen",
    "opening-animation"
  ],
  "license": "MIT",
  "author": "zhang-23x",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang-23x/dsh-deepseek-splash.git"
  },
  "homepage": "https://github.com/zhang-23x/dsh-deepseek-splash#readme",
  "bugs": {
    "url": "https://github.com/zhang-23x/dsh-deepseek-splash/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
