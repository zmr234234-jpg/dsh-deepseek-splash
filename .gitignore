# Build output. The rendered launch screen is the one artifact that ships: the
# plugin's host half reinstalls it, so a `github:` install needs it in the repo.
dist/*
!dist/splash.html

# Python caches
__pycache__/
*.pyc

# Verification frames captured with headless Edge.
# The curated stills used by the README live in docs/ and ARE committed.
shots/

# Intermediates from tools/trace_whale.py
assets/whale.b64
assets/whale.png
assets/_preview-light.html

# Backups and local scratch
*.bak
*.log
